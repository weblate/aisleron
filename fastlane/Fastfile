# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  
    # sh "your_script.sh"
    # You can also use other beta testing services here
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    upload_to_play_store
  end

  desc "Take application screenshots"
  lane :screenshots do |options|
      # To run from terminal: fastlane screenshots
      # To run a specific test: fastlane screenshots test:screenshot_AccountPreferences
      # Build the debug and AndroidTest packages so they are available for screenshots
      gradle(task: "assembleDebug assembleDebugAndroidTest")

      # Dynamically locate APKs
      app_apk = Dir.glob(File.expand_path("../app/build/outputs/apk/debug/com.aisleron-*-debug.apk")).first
      tests_apk = Dir.glob(File.expand_path("../app/build/outputs/apk/androidTest/debug/com.aisleron-*-debug-androidTest.apk")).first

      base_args = {
          device_type: "phone",
          locales: ["en-US"],
          app_package_name: "com.aisleron.debug",
          test_instrumentation_runner: "com.aisleron.di.KoinInstrumentationTestRunner",
          use_timestamp_suffix: false,
          app_apk_path: app_apk,
          tests_apk_path: tests_apk,
          skip_open_summary: true
        }

      if options[:test]
          target = options[:test]
          unless target.include?("#")
              target = "com.aisleron.screenshots.CaptureScreenshots##{target}"
          end
          base_args[:use_tests_in_classes] = [target]
      else
          base_args[:use_tests_in_packages] = ["com.aisleron.screenshots"]
      end

      # Take light mode screenshots
      screengrab(
          base_args.merge(output_directory: "fastlane/screenshots/light-mode")
      )

      # Take dark mode screenshots
      screengrab(
          base_args.merge(
            output_directory: "fastlane/screenshots/dark-mode",
            launch_arguments: ["uiMode dark"]
          )
      )
  end

  desc "Build Release APK and AAB and move to custom folder"
  lane :assemble_release_artifacts do
    # Build the artifacts
    gradle(task: "clean assembleRelease bundleRelease")

    # Define the destination
    output_dir = File.expand_path(ENV["RELEASE_ARTIFACT_PATH"])

    # Find and copy the APK
    apk_path = Dir.glob("../app/build/outputs/apk/release/com.aisleron-*-release.apk").first
    if apk_path
      FileUtils.cp(apk_path, output_dir)
      UI.success("Copied APK: #{File.basename(apk_path)}")
    else
      UI.error("Could not find any APK in the release folder!")
    end

    # Find and copy the AAB
    bundle_path = Dir.glob("../app/build/outputs/bundle/release/com.aisleron-*-release.aab").first
    if bundle_path
      FileUtils.cp(bundle_path, output_dir)
      UI.success("Copied AAB: #{File.basename(bundle_path)}")
    else
      UI.error("Could not find any AAB in the release folder!")
    end
  end

  desc "Sync app documentation for F-Droid, Play Store, and README"
  lane :sync_documentation do
    docs_includes_dir  = "../../../code-projects/aisleron.docs/_includes"
    metadata_dir       = "metadata/android/en-US"
    description_path   = File.join(docs_includes_dir, "aisleron_full_description.md")
    readme_path        = "../README.md"
    store_path         = File.join(metadata_dir, "full_description.txt")
    changelog_src_dir  = File.join(docs_includes_dir, "changelogs")
    changelog_dest_dir = File.join(metadata_dir, "changelogs")

    master_content = File.read(description_path)
    master_content = master_content.strip

    # Process GitHub README.md (Keep links, resolve docs URLs)
    if File.exist?(readme_path)
      readme_content = master_content.gsub('./docs/', 'https://aisleron.com/docs/')
      readme_text = File.read(readme_path)
      start_tag = "<!-- START_APP_DESCRIPTION -->"
      end_tag = "<!-- END_APP_DESCRIPTION -->"

      pattern = /#{Regexp.escape(start_tag)}.*?#{Regexp.escape(end_tag)}/m
      if readme_text.match?(pattern)
        updated_readme = readme_text.sub(pattern, "#{start_tag}\n\n#{readme_content}\n\n#{end_tag}")
        File.write(readme_path, updated_readme)
        UI.success("Updated README.md")
      else
        UI.important("README.md found, but marker tags #{start_tag} and #{end_tag} are missing!")
      end
    else
      UI.error("Could not find README.md!")
    end

    # Process F-Droid & Google Play Store description
    if File.exist?(store_path)
      store_text = master_content.dup

      # 1. Strip Markdown links: [Link Text](URL) -> Link Text
      store_text = store_text.gsub(/\[([^\]]+)\]\([^)]+\)/, '\1')

      # 2. Replace header markup "## " with a newline to create a blank line
      store_text = store_text.gsub(/^\s*#+\s*/, "\n").strip

      File.write(store_path, store_text)

      UI.success("Updated shared store description at #{store_path}")
    else
      UI.error("Could not find full_description.txt!")
    end


    # Process Numbered Changelogs
    if Dir.exist?(changelog_src_dir)
      # Target only numbered markdown files (e.g., 25.md)
      Dir.glob("#{changelog_src_dir}/[0-9]*.md").each do |src_file|
        version_code = File.basename(src_file, ".md")
        dest_file = File.join(changelog_dest_dir, "#{version_code}.txt")
        changelog_text = File.read(src_file).dup

        # 1. Strip Markdown links: [Link Text](URL) -> Link Text
        changelog_text = changelog_text.gsub(/\[([^\]]+)\]\([^)]+\)/, '\1')

        # 2. Strip Markdown headers
        changelog_text = changelog_text.gsub(/^\s*#+\s*/, "\n")

        # 3. Replace ' (Github).' with '.'
        changelog_text = changelog_text.gsub(/\s*\(GitHub\)\./, '.')

        changelog_text = changelog_text.strip

        File.write(dest_file, changelog_text)

        UI.success("Synced changelog: #{version_code}.txt")
      end
    else
      UI.error("Could not find changelogs source directory at #{changelog_src_dir}!")
    end
  end
end
